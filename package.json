{
    "name": "@webtides/element-library",
    "version": "0.1.0",
    "description": "A set of web components built with @webtides/element-js",
    "type": "module",
    "main": "index.js",
    "module": "index.js",
    "repository": "https://github.com/webtides/element-library",
    "author": "@webtides",
    "license": "MIT",
    "dependencies": {
        "@glidejs/glide": "3.4.1",
        "@webtides/element-js": "^1.1.0",
        "lozad": "^1.16.0"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.23.0",
        "@chromatic-com/storybook": "^1.4.0",
        "@storybook/addon-a11y": "^8.1.3",
        "@storybook/addon-coverage": "^1.0.4",
        "@storybook/addon-essentials": "^8.1.3",
        "@storybook/addon-interactions": "^8.1.3",
        "@storybook/addon-links": "^8.1.3",
        "@storybook/blocks": "^8.1.3",
        "@storybook/test": "^8.1.3",
        "@storybook/web-components": "^8.1.3",
        "@storybook/web-components-vite": "^8.1.3",
        "@vitest/browser": "^4.0.0",
        "@vitest/coverage-istanbul": "^4.0.0",
        "@vitest/ui": "^4.0.0",
        "autoprefixer": "^9.7.4",
        "deepmerge": "^4.2.2",
        "eslint": "^7.9.0",
        "eslint-config-prettier": "^6.11.0",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-prettier": "^3.1.4",
        "eslint-plugin-storybook": "^0.8.0",
        "husky": "^4.3.0",
        "lint-staged": "^10.4.0",
        "lit": "^3.1.3",
        "playwright": "^1.49.0",
        "postcss-import": "^12.0.1",
        "postcss-nested": "^4.2.1",
        "prettier": "^3.2.5",
        "storybook": "^8.1.3",
        "stylelint": "^13.7.1",
        "stylelint-config-standard": "^20.0.0",
        "vitest": "^4.0.0"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "scripts": {
        "dev": "storybook dev -p 3000 --no-open",
        "lint": "eslint ./src/**/*.js && stylelint ./src/**/*.css",
        "lint:js": "eslint ./src/**/*.js",
        "lint:css": "stylelint ./src/**/*.css",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "build-storybook": "storybook build"
    },
    "lint-staged": {
        "*.{js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{yaml,yml,md}": [
            "prettier --write"
        ]
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    }
}
