{
  "name": "@webtides/element-library",
  "version": "0.2.0",
  "description": "A set of web components built with @webtides/element-js",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./all": {
      "types": "./types/all.d.ts",
      "default": "./all.js"
    },
    "./catalog": {
      "types": "./catalog.d.ts",
      "default": "./catalog.js"
    },
    "./*": {
      "types": "./types/src/components/*/*.d.ts",
      "default": "./src/components/*/*.js"
    },
    "./*/define": {
      "types": "./types/src/components/*/*.define.d.ts",
      "default": "./src/components/*/*.define.js"
    },
    "./themes/*.css": "./src/themes/*.css",
    "./styles/*.css": "./src/styles/*.css",
    "./custom-elements.json": "./custom-elements.json",
    "./web-types.json": "./web-types.json",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "web-types": "./web-types.json",
  "sideEffects": [
    "./all.js",
    "./src/components/*/*.define.js"
  ],
  "files": [
    "src/components/**/*.js",
    "src/components/**/*.md",
    "!src/components/**/*.stories.js",
    "!src/components/**/*.test.*.js",
    "src/utils/**/*.js",
    "src/styles/**/*.js",
    "!src/styles/**/*.test.*.js",
    "src/styles/*.css",
    "src/themes/*.css",
    "types/**/*.d.ts",
    "all.js",
    "catalog.js",
    "catalog.d.ts",
    "index.js",
    "custom-elements.json",
    "web-types.json",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webtides/element-library.git"
  },
  "homepage": "https://webtides.github.io/element-library",
  "bugs": {
    "url": "https://github.com/webtides/element-library/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "element-js",
    "webtides",
    "ui-library",
    "components"
  ],
  "author": "@webtides",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@glidejs/glide": "~3.6.2",
    "@webtides/element-js": "^1.3.1",
    "lozad": "^1.16.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/web-components": "^10.4.1",
    "@storybook/web-components-vite": "^10.4.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@webtides/element-js-ssr-renderer": "^0.4.0",
    "axe-core": "^4.12.0",
    "custom-element-jet-brains-integration": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "lit": "^3.3.3",
    "playwright": "^1.60.0",
    "prettier": "^3.9.10",
    "storybook": "^10.4.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "storybook dev -p 3000 --no-open",
    "lint": "vp lint",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "build-storybook": "storybook build",
    "analyze": "cem analyze --config custom-elements-manifest.config.mjs --outdir .",
    "analyze:watch": "cem analyze --config custom-elements-manifest.config.mjs --outdir . --watch",
    "build:types": "tsc -p tsconfig.json",
    "gen:catalog": "npx -y @webtides/element-js-ssr-renderer catalog --manifest custom-elements.json -o catalog.js && vp fmt catalog.js",
    "test:catalog": "npm run gen:catalog && node test/catalog.smoke.mjs && tsc -p test/tsconfig.catalog.json",
    "prepack": "npm run analyze && npm run build:types && npm run gen:catalog",
    "prepare": "husky && npm run analyze && npm run build:types"
  },
  "lint-staged": {
    "*.js": [
      "vp lint --fix",
      "vp fmt"
    ],
    "*.{yaml,yml,md,json}": [
      "vp fmt"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vitest": "5.1.0"
  }
}
