{
    "name": "@webtides/element-library",
    "version": "0.1.0",
    "description": "A set of web components built with @webtides/element-js",
    "type": "module",
    "main": "index.js",
    "module": "index.js",
    "repository": "https://github.com/webtides/element-library",
    "author": "@webtides",
    "license": "MIT",
    "dependencies": {
        "@glidejs/glide": "~3.6.2",
        "@webtides/element-js": "^1.2.11",
        "lozad": "^1.16.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@storybook/addon-a11y": "^10.4.1",
        "@storybook/addon-coverage": "^3.0.1",
        "@storybook/addon-docs": "^10.4.1",
        "@storybook/addon-links": "^10.4.1",
        "@storybook/web-components": "^10.4.1",
        "@storybook/web-components-vite": "^10.4.1",
        "@vitest/browser": "^4.1.7",
        "@vitest/browser-playwright": "^4.1.7",
        "@vitest/coverage-istanbul": "^4.1.7",
        "@vitest/ui": "^4.1.7",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-storybook": "^10.4.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "lit": "^3.3.3",
        "playwright": "^1.60.0",
        "prettier": "^3.8.3",
        "storybook": "^10.4.1",
        "stylelint": "^13.7.1",
        "stylelint-config-standard": "^20.0.0",
        "vite": "^7.2.4",
        "vitest": "^4.1.7"
    },
    "scripts": {
        "dev": "storybook dev -p 3000 --no-open",
        "lint": "eslint ./src/**/*.js && stylelint ./src/**/*.css",
        "lint:js": "eslint ./src/**/*.js",
        "lint:css": "stylelint ./src/**/*.css",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "build-storybook": "storybook build",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{yaml,yml,md}": [
            "prettier --write"
        ]
    }
}
